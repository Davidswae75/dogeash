# Template for .env.local, the only env file the app reads (nuxt.config.ts and scripts/ load it).
# Copy to .env.local and fill in from Supabase: Project Settings → API. Never commit .env.local.
# On a host (Render), set the same names as environment variables before the build.

# Required: accounts and data come from Supabase.
SUPABASE_URL=https://your-project-ref.supabase.co
# The publishable (or legacy anon) key. Safe in the browser: the database's access rules protect the data.
SUPABASE_KEY=

# Optional: only `npm run db:types` needs it (the "your-project-ref" part of SUPABASE_URL).
# SUPABASE_PROJECT_REF=

# Server only: payments use it to record what Paystack confirmed. It bypasses every access rule: never expose it.
# Supabase: Project Settings -> API Keys -> secret key (or the legacy service_role key).
SUPABASE_SECRET_KEY=

# Server only: Paystack's secret key (Paystack: Settings -> API Keys & Webhooks). Use the sk_test_ key until
# going live. Never in the browser, never committed. The site uses Paystack's hosted checkout, so no public key.
PAYSTACK_SECRET_KEY=
