# Copy to .env.local and fill in from Supabase: Project Settings → API. Never commit it.
# Required: accounts and data come from Supabase.
NUXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The publishable (or legacy anon) key. Safe in the browser: the database's access rules protect the data.
NUXT_PUBLIC_SUPABASE_KEY=

# Server only, and only when a server route needs it. It bypasses every access rule: never expose it.
# NUXT_SUPABASE_SECRET_KEY=
